# 相对路径以项目根目录为基准；生产建议使用固定的绝对路径。
DATA_DIR=./data
MAX_UPLOAD_MB=50
MAX_UNCOMPRESSED_MB=200
MAX_ZIP_ENTRIES=4096
CALCULATION_TIMEOUT=120
JOB_TIMEOUT=300
PRINT_TIMEOUT=60
MATHCAD_PROGID=MathcadPrime.Application
MATHCAD_INSTALL_DIR=C:/Program Files/PTC/Mathcad Prime 12.0.1.0
PRINT_CONFIG=config/print-uia.json
RESULT_STRATEGY=api_recalculate
# 必须先通过真实 smoke，不能把业务 Mock 测试当作实机验证。
INTEGRATION_VERIFIED=false
# smoke 确认后填写 column-major 或 row-major；未配置时矩阵只读。
# MATRIX_XML_ORDER=column-major
